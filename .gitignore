# --- Secrets and credentials (repo is public) ---
# Keep *.example files so the expected variables are documented.
.env
.env.*
!.env.example
*.pem
*.key
# Backstage local overrides often hold tokens
*.local.yaml
# Kubernetes access
kubeconfig
*.kubeconfig
.kube/

# --- Go (from github/gitignore Go.gitignore) ---
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
go.work
go.work.sum
# Local build output
/bin/

# --- Node / Backstage (from github/gitignore Node.gitignore) ---
node_modules/
dist
dist-types
coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
.eslintcache
# Yarn: ignore the cache, keep the pinned release and config
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- Local data volumes (bind mounts from docker compose) ---
monitoring/data/
.data/

# --- macOS / editors ---
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
