{
  "uid": "slo-demo",
  "title": "slo-demo SLOs",
  "description": "SLI vs SLO, error budget and burn rate for slo-demo-service. Provisioned from monitoring/grafana/provisioning/dashboards/json/slo-demo.json; edit the file, not the UI.",
  "tags": [
    "slo",
    "slo-demo"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Firing and pending SLO alerts",
      "description": "ALERTS series from the Prometheus rules (no Alertmanager). Empty means no alert is pending or firing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "slo": 2,
              "severity": 3,
              "job": 4,
              "instance": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No pending or firing alerts"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Availability (D1: 2xx/3xx good, target 99.5%)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SLI vs SLO (28d)",
      "description": "Good-event ratio over the rolling 28 days (1 - slo:sli_error:ratio_rate28d) against the target slo:objective:ratio. Gaps mean no data or an idle service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_error:ratio_rate28d{slo=\"availability\"} > -Inf",
          "legendFormat": "SLI 28d",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:objective:ratio{slo=\"availability\"}",
          "legendFormat": "SLO target",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "No data (idle or no samples)",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SLO target"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error budget remaining (28d)",
      "description": "slo:error_budget_remaining:ratio_rate28d: 100% = untouched, 0% = spent, negative = SLO missed. Colour steps are placeholders, not decisions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 9,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:error_budget_remaining:ratio_rate28d{slo=\"availability\"} > -Inf",
          "legendFormat": "budget remaining",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "No data (idle or no samples)",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Burn rate by window",
      "description": "slo:error_budget_burn_rate:ratio_rate<w>. 1 spends the 28d budget in exactly 28 days. Threshold lines are the D6 alert thresholds: 1x (ticket, 3d+6h), 6x (page, 6h+30m), 14.4x (page, 1h+5m).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:error_budget_burn_rate:ratio_rate5m{slo=\"availability\"} > -Inf",
          "legendFormat": "5m",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:error_budget_burn_rate:ratio_rate30m{slo=\"availability\"} > -Inf",
          "legendFormat": "30m",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:error_budget_burn_rate:ratio_rate1h{slo=\"availability\"} > -Inf",
          "legendFormat": "1h",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:error_budget_burn_rate:ratio_rate6h{slo=\"availability\"} > -Inf",
          "legendFormat": "6h",
          "refId": "D",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:error_budget_burn_rate:ratio_rate3d{slo=\"availability\"} > -Inf",
          "legendFormat": "3d",
          "refId": "E",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "noValue": "No data (idle or no samples)",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 15
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Latency (D2: <= 300 ms good, target 95%)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
